{
  "schemaVersion": 1,
  "id": "flashclips",
  "version": "${version}",
  "name": "FlashClips",
  "description": "Chat-free rolling screen recording. Saves a short mp4 when you pop a totem, get a kill, or press the clip key. Needs Flashback (uses its FFmpeg).",
  "authors": ["Kinggregv2"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.flashclips.FlashClips"]
  },
  "mixins": ["flashclips.mixins.json"],
  "accessWidener": "flashclips.classtweaker",
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": ">26.2 <26.4",
    "java": ">=25",
    "fabric-api": "*",
    "flashback": ">=0.43.0"
  }
}
